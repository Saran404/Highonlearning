# ---- Database (the SQL Server database is created by database/01_schema.sql) ----
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=your-sql-server-host
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=replace-with-your-database-password
DB_TRUSTED_CONNECTION=false
DB_TRUST_SERVER_CERTIFICATE=true

# ---- Auth ----
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_EXPIRE_HOURS=10
# strict  -> a second device gets 409 ALREADY_LOGGED_IN
# replace -> the new login revokes the old device (pushes SESSION_REVOKED over WebSocket)
SINGLE_DEVICE_MODE=strict

# ---- Web ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development

# ---- Proctoring ----
UPLOAD_DIR=./uploads
MAX_MALPRACTICE=3
# Serve /uploads publicly. Leave false: snapshots are served through signed, expiring URLs.
SERVE_UPLOADS_STATIC=false
